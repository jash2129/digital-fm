TAVUS_API_KEY=your_tavus_api_key_here
TAVUS_PERSONA_ID=p2bb5fbde523

# Event configuration — directory name under prompts/ (default: aws-summit-mumbai-2026)
# Set to digital-finance-manager to run the F&I pricing-panel persona instead of an AWS booth event.
# next.config.ts forwards this into the client bundle too, so this one variable is enough.
# EVENT_CONFIG=digital-finance-manager

# Speech recognition for Max's calls. Deepgram is the DEFAULT: it hears the echo-cancelled microphone,
# so Max's own voice is not transcribed. The key stays on the server (/api/stt/token mints a 60 s token).
# Without it every call falls back to the browser's recognizer.
DEEPGRAM_API_KEY=your_deepgram_api_key_here
# Optional: webspeech turns Deepgram off for every call (one call: add ?stt=webspeech to its URL).
# NEXT_PUBLIC_ variables are built into the page: change it, then rebuild / redeploy.
# NEXT_PUBLIC_STT_ENGINE=webspeech

# How Max talks (all off by default; each needs XAI_API_KEY or OPENAI_API_KEY; redeploy after changing).
# MAX_UNDERSTANDING=ai  - the AI works out what longer replies mean; the script still picks the words
# MAX_SPEECH=ai         - Option C: the AI says the approved line in its own words, checked
# MAX_MODE=free         - Option D: the AI runs the whole call; prices, facts and the disclosure are still guarded
# FREE_AI_TIMEOUT_MS=4000
# MAX_STREAM=on         - Max starts speaking at the first checked sentence (Option C and free mode)

# Optional: errors also go to Sentry (they are always logged as JSON lines). From Sentry: Settings > Client Keys (DSN)
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
